# ============ 复制本文件为 .env 并填写真实值，然后执行 chmod 600 .env ============
# 本文件严禁提交真实密钥；.env 已被 .gitignore 排除。

# ===== 镜像仓库（阿里云 ACR）=====
ACR_HOST=registry.cn-hangzhou.aliyuncs.com
ACR_NAMESPACE=你的命名空间

# ===== 数据库（宝塔原生 MySQL）=====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=student_archives
DB_USERNAME=数据库账号
DB_PASSWORD=数据库密码

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=Redis密码

# ===== 邮件（QQ 邮箱填授权码，不是登录密码）=====
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=发件邮箱@qq.com
MAIL_PASSWORD=邮箱授权码

# ===== JWT：Base64 编码的 HMAC-SHA256 密钥（至少 256 位），请随机生成一长串 =====
JWT_SECRET=请替换为一长串随机字符串

# ===== 阿里云 OSS =====
OSS_ENDPOINT=oss-cn-chengdu.aliyuncs.com
OSS_ACCESS_KEY_ID=你的AccessKeyId
OSS_ACCESS_KEY_SECRET=你的AccessKeySecret
OSS_BUCKET_NAME=student-archives

# ===== DeepSeek AI =====
DEEPSEEK_API_KEY=sk-你的key
