# ============================================================
#  个人开发环境配置
#  复制此文件为 .env 并填入自己的配置
#
#  Windows:
#    copy .env.example .env
#  Mac/Linux:
#    cp .env.example .env
#
#  Spring Boot 3.3 启动时自动加载项目根目录的 .env 文件
#  ⚠️ .env 已加入 .gitignore，不会提交到版本库
#  ⚠️ 修改 .env 后需要重启应用才能生效
# ============================================================

# ===================== 必须配置 =====================

# ---------- MySQL ----------
# 团队共享同一远程数据库，联系管理员获取密码；
# 如需本地库，改成 DB_HOST=localhost / DB_USERNAME=root 并填本地密码。
DB_PASSWORD=数据库密码

# ---------- QQ 邮箱（每人配置自己的）----------
# 你的 QQ 邮箱地址
MAIL_USERNAME=你的QQ号@qq.com

# QQ 邮箱 SMTP 授权码（非 QQ 登录密码！）
# 获取方式：QQ邮箱 → 设置 → 账户 → POP3/SMTP服务 → 生成授权码
MAIL_PASSWORD=你的SMTP授权码

# ---------- 阿里云 OSS（fmy 配置，团队共享）----------
# 团队成员在各自的 .env 中填入相同的密钥即可共享使用同一 OSS。
# 如使用自己的 OSS，替换为对应密钥即可。
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=你的AccessKeyId
OSS_ACCESS_KEY_SECRET=你的AccessKeySecret
OSS_BUCKET_NAME=student-archives

# ---------- DeepSeek 大模型（lzw 配置，AI 对话模块）----------
# 在 platform.deepseek.com 申请 API Key，填入后 AI 对话才能正常生成回复
# 不配置时，AI 对话会返回兜底话术「抱歉，AI 服务暂时不可用，请稍后重试。」
DEEPSEEK_API_KEY=sk-你的DeepSeekApiKey
# 以下有默认值，一般不需要改
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ===================== 可选配置（有默认值，一般不需要改）=====================

# JWT 签名密钥（开发环境用默认值即可，生产环境必须更换）
# JWT_SECRET=hq5WLXCfp/7kKvSbL/SrnU9FDfZGdrL26V05eDPKoio=

# MySQL 服务器（默认已指向团队远程服务器）
# DB_HOST=8.137.191.26
# DB_PORT=3306
# DB_USERNAME=StuArch
# DB_NAME=student_archives

# ---------- Redis（连接各自的本地 Redis，默认 127.0.0.1:6379，一般不需要改）----------
# 本地 Redis 设置了密码才填 REDIS_PASSWORD（未设置则留空 REDIS_PASSWORD= 即可）
REDIS_PASSWORD=123456
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DATABASE=0

# 邮件服务器
# MAIL_HOST=smtp.qq.com
# MAIL_PORT=587
