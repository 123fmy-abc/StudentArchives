# ============================================================
#  个人开发环境配置
#  复制此文件为 .env 并填入自己的配置
#
#  Windows:
#    copy .env.example .env
#  Mac/Linux:
#    cp .env.example .env
#
#  Spring Boot 3.3 启动时自动加载项目根目录的 .env 文件
#  ⚠️ .env 已加入 .gitignore，不会提交到版本库
#  ⚠️ 修改 .env 后需要重启应用才能生效
# ============================================================

# ===================== 必须配置 =====================

# ---------- MySQL ----------
# 团队共享同一数据库，联系管理员获取密码
# 数据库名默认为 student_archives（一般不需要改）
DB_PASSWORD=数据库密码

# ---------- Redis ----------
# Redis 密码（联系管理员获取）
REDIS_PASSWORD=Redis密码

# Redis database 索引 —— 不同开发者使用不同编号，避免缓存相互干扰
# ⚠️ 范围 0~15，每人选一个不同的！
# 建议：张三=0, 李四=1, 王五=2 ...
REDIS_DATABASE=0

# ---------- QQ 邮箱（每人配置自己的）----------
# 你的 QQ 邮箱地址
MAIL_USERNAME=你的QQ号@qq.com

# QQ 邮箱 SMTP 授权码（非 QQ 登录密码！）
# 获取方式：QQ邮箱 → 设置 → 账户 → POP3/SMTP服务 → 生成授权码
MAIL_PASSWORD=你的SMTP授权码

# ===================== 可选配置（有默认值，一般不需要改）=====================

# JWT 签名密钥（开发环境用默认值即可，生产环境必须更换）
# JWT_SECRET=hq5WLXCfp/7kKvSbL/SrnU9FDfZGdrL26V05eDPKoio=

# MySQL 服务器（默认已指向团队远程服务器）
# DB_HOST=8.137.191.26
# DB_PORT=3306
# DB_USERNAME=StuArch
# DB_NAME=student_archives

# Redis 服务器
# REDIS_HOST=8.137.191.26
# REDIS_PORT=6379

# 邮件服务器
# MAIL_HOST=smtp.qq.com
# MAIL_PORT=587
